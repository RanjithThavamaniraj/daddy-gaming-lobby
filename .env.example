# Vite exposes variables prefixed with VITE_ to the client bundle.
# NEXT_PUBLIC_* names are also supported for compatibility.

# Optional — used for absolute Open Graph URLs in production
# VITE_SITE_URL=https://daddy-gaming-lobby.vercel.app

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Optional aliases (same values as above)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
